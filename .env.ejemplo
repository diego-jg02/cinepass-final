# Copia este archivo como .env (no se sube a GitHub) para correr las pruebas de base de datos.
# Project URL y clave pública: Supabase → Project Settings → API (son las mismas de js/config.js)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional, SOLO en tu PC: clave secreta (service_role / sb_secret_...). Se usa para crear usuarios de
# prueba, darles rol admin y migrar datos. NUNCA en js/config.js, en el navegador ni en GitHub.
SUPABASE_SECRET_KEY=
