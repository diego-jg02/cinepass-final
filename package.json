{
  "name": "cinepass",
  "version": "1.0.0",
  "private": true,
  "description": "CinePass — reserva de entradas de cine. Pruebas E2E con Playwright.",
  "scripts": {
    "servidor": "node pruebas/servidor.js",
    "test": "playwright test",
    "test:ver": "playwright test --headed --workers=1",
    "test:ui": "playwright test --ui",
    "reporte": "playwright show-report pruebas/reporte",
    "informe": "playwright test && node pruebas/generar-informe.js",
    "solo-informe": "node pruebas/generar-informe.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "docx": "^9.16.1"
  }
}
